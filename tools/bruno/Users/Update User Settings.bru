meta {
  name: Update User Settings
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/users/current/settings
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "updates": {
      "hasCompletedOnboarding": true,
      "theme": "dark"
    }
  }
}

docs {
  Partial update of the current user's settings map. Only keys present in `updates`
  are changed; a null value removes that key. Returns 204.
}
