meta {
  name: Initiate OAuth
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/oauth/{{service}}/initiate
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "resultForwardUrl": "https://app.scratch.md/oauth/callback-step-2",
    "workbookId": "{{workbookId}}",
    "connectionName": "My Connection"
  }
}

docs {
  Returns the provider authorization redirect URL ({ authUrl }) for a connector.
  Required: `resultForwardUrl` (where the callback forwards the result) and
  `workbookId`. Optional extras include `connectionMethod` (OAUTH_SYSTEM |
  OAUTH_CUSTOM), `customClientId`/`customClientSecret`, `connectionName`,
  `returnPage`, `connectorAccountId`, and connector-specific fields
  (e.g. `zohoDataCenter`, `quickbooksSandbox`).
}
