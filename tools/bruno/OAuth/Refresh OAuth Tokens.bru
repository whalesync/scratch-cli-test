meta {
  name: Refresh OAuth Tokens
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/oauth/refresh
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "connectorAccountId": "{{connectorAccountId}}"
  }
}

docs {
  Forces a refresh of the stored OAuth tokens for a connection. Returns
  { success }.
}
