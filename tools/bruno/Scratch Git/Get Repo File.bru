meta {
  name: Get Repo File
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/scratch-git/{{workbookId}}/file?path=/airtable/posts/rec123.json
  body: none
  auth: inherit
}

params:query {
  path: /airtable/posts/rec123.json
  ~branch: main
  ~connectorAccountId: {{connectorAccountId}}
  ~useConfigRepo: true
  ~useScratchRepo: true
}

docs {
  Reads one file's content from the git repo. `path` is required. `branch`
  defaults to main. Repo selection mirrors List Repo Files.
}
