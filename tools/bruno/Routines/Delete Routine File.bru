meta {
  name: Delete Routine File
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/workbooks/{{workbookId}}/routines/file?path=routines/example.ts
  body: none
  auth: inherit
}

params:query {
  path: routines/example.ts
}

docs {
  Deletes a routine file (and its ROUTINE schedule, if any). `path` is required.
  Returns 204.
}
