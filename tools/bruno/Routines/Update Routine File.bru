meta {
  name: Update Routine File
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/workbooks/{{workbookId}}/routines/file
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "path": "routines/example.yaml",
    "content": "name: Example routine\nschedule: '0 18 * * *'\nsteps: []\n"
  }
}

docs {
  Replaces the content of an existing routine file at `path`. Rejects a missing
  file (404) or invalid YAML (400).
}
