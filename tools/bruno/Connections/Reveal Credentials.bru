meta {
  name: Reveal Credentials
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/workbooks/{{workbookId}}/connections/{{connectorAccountId}}/credentials/reveal
  body: none
  auth: inherit
}

docs {
  Returns the connection's decrypted user-provided credentials (so the UI can
  pre-fill them for editing). Sensitive — handle with care.
}
