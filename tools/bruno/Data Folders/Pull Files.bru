meta {
  name: Pull Files
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/data-folder/{{dataFolderId}}/pull-files
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "workbookId": "{{workbookId}}",
    "filePaths": ["/airtable/posts/rec123.json"]
  }
}

docs {
  Pulls specific files from the external source for this data folder. `workbookId`
  is required and `filePaths` must contain at least one path. Acquires a pull lock
  on the folder and returns { jobId }.
}
