meta {
  name: List Team Live Exports
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/internal/whalesync/teams/{{whalesyncTeamId}}/live-exports
  body: none
  auth: inherit
}

docs {
  List a team's Live Export workbooks, newest first, skipping those pending deletion.
  Returns { liveExports: [{ id, name, createdAt, updatedAt }] }. Returns an empty list if
  the team has no shadow user (never creates one). Returns 409 when the user holding the
  team id is a real Scratch account.
}
