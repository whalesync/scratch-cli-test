meta {
  name: List Pending Team Links
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/internal/whalesync/team-links/pending
  body: none
  auth: inherit
}

params:query {
  ~after: {{whalesyncUserId}}
}

docs {
  The Whalesync user ids of shadow users that have no team yet, in ascending order, 500
  a page. Pass the last id of a page as `after` for the next. Returns
  { whalesyncUserIds: string[] }; an empty list is the end.
}
