meta {
  name: Clear Subscription
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/internal/whalesync/users/{{whalesyncUserId}}/subscription
  body: none
  auth: inherit
}

docs {
  Clear a shadow user's internal Whalesync-plan subscription. Returns 409 if the user
  has a real Scratch Stripe subscription. Idempotent if the user does not exist or has
  no Whalesync plan. Returns { scratchUserId, cleared }.
}
