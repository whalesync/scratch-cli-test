meta {
  name: Deprovision Team
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/internal/whalesync/teams/{{whalesyncTeamId}}
  body: none
  auth: inherit
}

docs {
  Delete the team's pure shadow user with its tokens and, when it is the sole member, its
  organization and the workbooks that organization owns. Idempotent if the team has no
  shadow user. Returns 204, or 409 when the user holding the team id is a real Scratch
  account (never deleted).
}
