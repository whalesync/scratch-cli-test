meta {
  name: Update Subscription
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/internal/whalesync/subscription
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "whalesyncTeamId": "tm_abc123def456",
    "subscription": {
      "status": "active",
      "liveExportCadence": "daily"
    }
  }
}

docs {
  The old way to set the team's Live Export access, until every Whalesync environment
  sends Set Live Export Access: the payload is mapped onto an access (paused unless
  `status` is `active`), and the plan never lapses. Returns
  { scratchUserId, updated, planType }, or { scratchUserId: null, updated: false,
  planType: null } when the team has no shadow user. Returns 409 when the user holding the
  team id is a real Scratch account.
}
