meta {
  name: Init Upload Patch
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/cli/v1/workbooks/{{workbookId}}/upload-patch/init
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "connectorAccountId": "{{connectorAccountId}}"
  }
}

docs {
  Step 1 of the upload-then-commit publish flow. Returns an opaque `uploadId` and a
  presigned GCS `presignedUrl` (plus `expiresInSeconds`); the CLI then PUTs the
  patch payload to that URL and calls Commit Upload Patch. `connectorAccountId` is
  required.
}
