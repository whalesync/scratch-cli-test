meta {
  name: Get Routine Files (CLI)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/cli/v1/workbooks/{{workbookId}}/routines/files?metadataOnly=false
  body: none
  auth: inherit
}

params:query {
  metadataOnly: false
}

docs {
  Every routine file of the workbook straight from Postgres (DEV-11399), each with
  the optimistic-concurrency `version` the CLI echoes back as `baseVersion` on
  push. `metadataOnly=true` omits the YAML `content` (what `scratchmd routines
  status` needs). Returns { files: [{ path, version, updatedAt, content? }] }.
}
