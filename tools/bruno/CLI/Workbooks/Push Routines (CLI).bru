meta {
  name: Push Routines (CLI)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/cli/v1/workbooks/{{workbookId}}/routines/push
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "upserts": [
      {
        "path": "routines/daily-pull.yaml",
        "content": "name: Daily Pull\nsteps:\n  - action: pull\n",
        "baseVersion": null
      }
    ],
    "deletes": []
  }
}

docs {
  Batch-pushes routine YAML files (`scratchmd routines push`). Routine definitions
  live in Postgres (DEV-11399); `upserts` are created/edited files (each a
  `routines/*.yaml` path + content), `deletes` are removed paths (bare strings or
  `{ path, baseVersion }`). Per-file `baseVersion` is the optimistic-concurrency
  token from GET routines/files (`null` = "expect new"); a stale push is refused
  with 409 `blocked_stale` listing `staleFiles`. The legacy `baseHead` git SHA is
  accepted and ignored. Returns { files: [{ path, version }], head, routines } —
  `head` is the config-repo `main` SHA after the transitional git mirror commit,
  or "" once the mirror is off.
}
