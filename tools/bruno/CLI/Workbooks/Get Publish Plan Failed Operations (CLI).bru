meta {
  name: Get Publish Plan Failed Operations (CLI)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/cli/v1/workbooks/{{workbookId}}/publish-v2/{{planId}}/failed-operations
  body: none
  auth: inherit
}

params:query {
  ~page: 1
  ~pageSize: 20
}

docs {
  The COMPLETE paginated set of connector-rejected (`failed-batch`) operations for a
  plan, one per file path. Used by the CLI's post-publish reconcile to route every
  failure into `failed-patches.json`. `page` / `pageSize` paginate.
}
