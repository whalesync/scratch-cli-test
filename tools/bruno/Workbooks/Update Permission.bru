meta {
  name: Update Permission
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/workbook/{{workbookId}}/permission/{{permissionId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "role": "viewer"
  }
}

docs {
  Updates a permission's role on a workbook.
}
