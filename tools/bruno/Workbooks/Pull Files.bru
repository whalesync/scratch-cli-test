meta {
  name: Pull Files
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/workbook/{{workbookId}}/pull-files
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "snapshotTableIds": ["snap_abc", "snap_xyz"]
  }
}

docs {
  Triggers a pull to sync files from external sources. `snapshotTableIds` is
  optional — omit to pull all tables. Returns { jobId }.
}
