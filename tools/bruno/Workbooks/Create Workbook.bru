meta {
  name: Create Workbook
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/workbook
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "My Workbook",
    "tables": [
      {
        "connectorAccountId": "{{connectorAccountId}}",
        "tableId": "tbl_abc"
      }
    ]
  }
}

docs {
  Creates a new workbook. `tables` is optional; each entry references a table on a
  connection to seed the workbook with.
}
