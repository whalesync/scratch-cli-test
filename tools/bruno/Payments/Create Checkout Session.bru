meta {
  name: Create Checkout Session
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/payment/checkout/{{planType}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "billingInterval": "month",
    "returnPath": "/settings/billing"
  }
}

docs {
  Starts a Stripe checkout session for the plan in the URL (`{{planType}}` e.g.
  PRO_PLAN | MAX_PLAN) and returns { url }. All body fields optional:
  `billingInterval` (month | year, defaults to month), `returnPath`, `cancelPath`.
}
