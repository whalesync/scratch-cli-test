{
  "name": "spinner-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": [
    "client",
    "server",
    "scratch-git-2",
    "scratch-desktop",
    "scratch-cli-tests",
    "packages/*",
    "test-api-fakes/*",
    "smoke-tests"
  ],
  "scripts": {
    "dev": "turbo dev --filter=!scratch-desktop",
    "build": "yarn install && turbo build",
    "migrate": "turbo migrate",
    "lint": "turbo lint",
    "format": "turbo format",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "typecheck": "turbo typecheck"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "turbo": "^2.8.3"
  },
  "resolutions": {
    "axios": "1.14.0"
  }
}
