{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to scratch server",
      "address": "127.0.0.1",
      "port": 9229,
      "enableContentValidation": true,
      "outputCapture": "std",
      "restart": true,
      "showAsyncStacks": true
    },
    {
      "name": "Debug scratch-desktop electron app",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/scratch-desktop",
      "runtimeExecutable": "${workspaceFolder}/scratch-desktop/node_modules/.bin/electron",
      "args": [
        "."
      ],
      "outputCapture": "std",
      "showAsyncStacks": true,
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/scratch-desktop/out/**/*.js"
      ]
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug scratchmd CLI",
      "program": "${workspaceFolder}/scratch-git-2/target/debug/scratchmd",
      "args": [
        "workspaces",
        "list"
      ],
      "cwd": "${workspaceFolder}/scratch-local-data",
      "sourceLanguages": [
        "rust"
      ]
    },
  ]
}
