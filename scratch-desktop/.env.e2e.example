# Template for the LIVE desktop E2E suite (`yarn test:e2e:live`).
#
# Copy this file to `.env.e2e` (gitignored) and fill in a real test-account API
# token. playwright.config.ts auto-loads `.env.e2e`. Without it, the live suite
# simply skips — it never fails for a missing secret. See e2e/README.md.
#
#   cp .env.e2e.example .env.e2e   # then paste the token below

# API-Token for the dedicated test account on test-api.scratch.md.
TESTING_ACCOUNT_API_KEY=

# The test account's email (used as the seeded session's display email).
TESTING_ACCOUNT_EMAIL=testing@whalesync.com

# Optional: override the backend the live test targets.
# SCRATCH_TEST_API_URL=https://test-api.scratch.md
