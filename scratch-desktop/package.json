{
  "name": "scratch-desktop",
  "version": "0.1.0",
  "description": "Scratch Desktop — Electron application",
  "main": "./out/main/index.js",
  "author": "Whalesync <support@whalesync.com>",
  "homepage": "https://scratch.md",
  "license": "UNLICENSED",
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "predev": "node scripts/build-native.cjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/build-native.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint-strict": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "prettier:check": "prettier --check \"src/**/*.ts\" \"src/**/*.tsx\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/ensure-electron-binary.cjs && node scripts/install-app-deps.cjs",
    "build:mac": "electron-vite build && UPDATE_CHANNEL=${UPDATE_CHANNEL:-desktop-test} electron-builder --mac",
    "build:mac:unsigned": "electron-vite build && UPDATE_CHANNEL=${UPDATE_CHANNEL:-desktop-test} CSC_IDENTITY='-' electron-builder --mac --config electron-builder.unsigned-mac.yml",
    "build:mac:local": "bash scripts/build_mac_local.sh",
    "build:mac:local-signed": "bash scripts/build_mac_local_signed.sh",
    "build:mac:prod-local": "bash scripts/build_mac_prod_local.sh",
    "run:mac": "OPEN_DEVTOOLS=1 ./dist/mac/Scratch.app/Contents/MacOS/Scratch",
    "build:linux": "electron-vite build && UPDATE_CHANNEL=${UPDATE_CHANNEL:-desktop-test} electron-builder --linux",
    "build:win": "node scripts/build-win.cjs"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lint": "^6.9.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/funnel-display": "^5.0.0",
    "@fontsource/geist-mono": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@mantine/core": "^8.3.5",
    "@mantine/hooks": "^8.3.5",
    "@mantine/notifications": "^8.3.5",
    "@spinner/shared-types": "0.0.0-dev",
    "@uiw/react-codemirror": "^4.25.3",
    "axios": "1.14.0",
    "chokidar": "^5.0.0",
    "codemirror": "^6.0.1",
    "diff": "^8.0.2",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "lodash": "^4.18.1",
    "lucide-react": "^0.544.0",
    "marked": "^17.0.5",
    "posthog-js": "^1.364.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-responsive-carousel": "^3.2.23",
    "react-router-dom": "^7.0.0",
    "swr": "^2.4.1",
    "yaml": "^2.8.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "35.0.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^3.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "postcss": "^8.0.0",
    "postcss-preset-mantine": "^1.18.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  },
  "resolutions": {
    "axios": "1.14.0"
  }
}
