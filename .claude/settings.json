{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(git log:*)",
      "Bash(nvm use:*)",
      "Bash(yarn test:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn lint-strict:*)",
      "Bash(yarn lint-fix:*)",
      "Bash(yarn tsc:*)",
      "Bash(yarn build:*)",
      "Bash(yarn format:*)",
      "Bash(yarn setup:*)",
      "Bash(yarn trigger-pull:*)",
      "Read(//private/tmp/**)",
      "Bash(lsof -ti:3011)",
      "Bash(cargo check:*)",
      "Bash(lsof -ti:3100)",
      "Bash(cargo test:*)",
      "Bash(cargo run:*)",
      "Bash(git clone:*)",
      "Bash(yarn install:*)",
      "Bash(cargo build:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "Run `nvm use && yarn format` from the repo root to format all code.",
            "statusMessage": "Running yarn format..."
          }
        ]
      }
    ]
  }
}
