{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(git log:*)",
      "Bash(nvm use:*)",
      "Bash(yarn test:*)",
      "Bash(yarn lint:*)",
      "Bash(yarn lint-strict:*)",
      "Bash(yarn lint-fix:*)",
      "Bash(yarn tsc:*)",
      "Bash(yarn build:*)",
      "Bash(yarn format:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "Run `nvm use && yarn format` from the repo root to format all code.",
            "statusMessage": "Running yarn format..."
          }
        ]
      }
    ]
  }
}
