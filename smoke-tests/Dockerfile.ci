# Lightweight container that runs smoke tests inside the Docker Compose network.
# Used by CI only (via `--profile ci`); local dev runs tests on the host via run.sh.

FROM node:22-alpine

WORKDIR /app

# Copy root yarn.lock for reproducible installs
COPY yarn.lock ./

# Create a minimal root package.json with only the workspaces we need
# (the full monorepo package.json references client/server/etc. which aren't here)
RUN echo '{ "private": true, "workspaces": ["packages/shared-types", "packages/test-utils", "smoke-tests"] }' > package.json

# Copy workspace deps of smoke-tests. shared-types' `main`/`types` point at
# `dist/`, so it has to be built before ts-jest can resolve the import.
COPY packages/shared-types/ packages/shared-types/
COPY packages/test-utils/ packages/test-utils/

# Copy smoke-tests package metadata first for layer caching
COPY smoke-tests/package.json smoke-tests/package.json

# Install dependencies (resolves the workspace symlinks for shared-types +
# test-utils) and build shared-types so its dist/ is on disk.
RUN yarn install --frozen-lockfile && yarn --cwd packages/shared-types build

# Copy test source files
COPY smoke-tests/ smoke-tests/

WORKDIR /app/smoke-tests

CMD ["yarn", "test:smoke"]
