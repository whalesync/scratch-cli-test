# Required — Scratch API key for authentication
SCRATCH_API_KEY=sk_test_abc123

# Optional - Scratch API key for a second user to test workspace permissions
SCRATCH_API_KEY_2=sk_test_xyz890

# Optional — Base URL of the Scratch server (defaults to http://localhost:3010)
# SCRATCH_API_URL=http://localhost:3010

# Postgres or Supabase connection URL (required for connection/linked/files suites)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testing
TEST_CONNECTOR_SERVICE=POSTGRES

# Optional — Path to prebuilt scratchmd binary (skips go build if set)
# SCRATCH_CLI_BINARY=/usr/local/bin/scratchmd

# Optional — Set to 1 for verbose CLI output
# DEBUG=1
