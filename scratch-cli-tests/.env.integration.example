# Required — API token for the primary test user
# Generate via: Settings > User > Generate API Token in the web app,
# or run `scratchmd auth login` and copy the apiToken from ~/.scratchmd/credentials.yaml
SCRATCH_API_KEY=your-api-token-here

# Optional — API token for a second user (permission tests)
# SCRATCH_API_KEY_2=second-user-token-here

# Optional — Base URL of the Scratch server (defaults to http://localhost:3010)
# SCRATCH_API_URL=http://localhost:3010

# Postgres connection URL (required for connection/linked/files/workspace-sync suites)
# Must be accessible from both the test runner and the Scratch server
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/your_db?schema=public

# Connector type: POSTGRES for local Postgres, SUPABASE for Supabase databases
TEST_CONNECTOR_SERVICE=POSTGRES

# Optional — Path to prebuilt scratchmd binary (skips cargo build if set)
# SCRATCH_CLI_BINARY=/usr/local/bin/scratchmd

# Optional — Set to 1 for verbose CLI command logging
# DEBUG=1
