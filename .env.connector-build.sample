# .env.connector-build — test-account secrets for /prepare-connector-build and /connector-build
#
# This .sample file is COMMITTED (var names only, no values). The real file
# `.env.connector-build` is gitignored; its contents live in the 1Password note
# "Scratch Connector QA — .env.connector-build". Copy them BY HAND into
# <repo-root>/.env.connector-build. When you add a new account, paste your additions
# back into that note so the team gets them. (No op CLI / automation by design.)
#
# Conventions:
#   - One block per provisioned test account, var names CB_<SERVICE>_<FIELD>.
#   - Default login email is testing@whalesync.com (a Whalesync-controlled mailbox,
#     usable for email-verification links during signup).
#   - Passwords are GENERATED by the credential helper at registration time and written
#     here automatically — you do not pick them by hand.
#   - Values are single-quoted: CB_FOO_PASSWORD='...'.
#   - /prepare-connector-build appends a new block here (empty) when it provisions a service.
#   - See docs/connector-test-accounts.md for the full mechanism.

# ---- TEMPLATE (copy per new service) ----
# CB_<SVC>_LOGIN_EMAIL='testing@whalesync.com'
# CB_<SVC>_PASSWORD=''            # generated at registration; do not hand-pick
# CB_<SVC>_API_TOKEN=''           # user_provided_params services
# CB_<SVC>_OAUTH_CLIENT_ID=''     # OAuth services
# CB_<SVC>_OAUTH_CLIENT_SECRET=''
# CB_<SVC>_OAUTH_REFRESH_TOKEN=''
# CB_<SVC>_ACCOUNT_ID=''
# CB_<SVC>_DATA_CENTER=''         # multi-region services (e.g. EU/US)
# CB_<SVC>_TRIAL_END=''           # YYYY-MM-DD for trials

# ---- Airtable ----
CB_AIRTABLE_API_TOKEN=''

# ---- Attio ----
CB_ATTIO_API_TOKEN=''

# ---- Pipedrive ----
CB_PIPEDRIVE_API_TOKEN=''

# ---- HubSpot ----
CB_HUBSPOT_API_TOKEN=''

# ---- Copper ----
CB_COPPER_API_TOKEN=''
CB_COPPER_EMAIL='testing@whalesync.com'

# ---- Zoho CRM ----
CB_ZOHO_OAUTH_CLIENT_ID=''
CB_ZOHO_OAUTH_CLIENT_SECRET=''
CB_ZOHO_OAUTH_REFRESH_TOKEN=''
CB_ZOHO_DATA_CENTER='EU'

# ---- GoHighLevel ----
CB_GOHIGHLEVEL_LOGIN_EMAIL='testing@whalesync.com'
CB_GOHIGHLEVEL_PASSWORD=''
CB_GOHIGHLEVEL_OAUTH_CLIENT_ID=''
CB_GOHIGHLEVEL_OAUTH_CLIENT_SECRET=''
