{
  "name": "scratch-v4-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "db:migrate": "prisma migrate dev",
    "setup": "ts-node -r tsconfig-paths/register src/bootstrap-command.ts setup",
    "trigger-pull": "ts-node -r tsconfig-paths/register src/bootstrap-command.ts trigger-pull",
    "poll": "ts-node -r tsconfig-paths/register src/bootstrap-command.ts poll",
    "publish-records": "ts-node -r tsconfig-paths/register src/bootstrap-command.ts publish",
    "clone-repo": "bash scripts/clone-repo.sh",
    "cleanup": "bash scripts/cleanup.sh",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^5.0.0",
    "@sinclair/typebox": "^0.32.0",
    "axios": "^1.7.0",
    "bullmq": "^5.59.0",
    "cheerio": "^1.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "html-minifier-terser": "^7.2.0",
    "ioredis": "^5.3.2",
    "lodash": "^4.17.21",
    "rate-limiter-flexible": "^9.1.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "webflow-api": "^3.0.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.14.0",
    "@types/node": "^22.0.0",
    "prisma": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  }
}
