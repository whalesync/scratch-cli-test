# Airtable connection (fill in before running)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

# Git repos root — must match --repos-dir on scratchmd serve
GIT_REPOS_DIR=/tmp/scratch-repos

# scratchmd HTTP server
SCRATCHMD_URL=http://localhost:3100

# Database (same as main server)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scratchpad

# Redis (same as main server)
REDIS_URL=redis://localhost:6379

# IDs used by the experiment setup command
EXP_ORG_ID=exp-org-1
EXP_WORKBOOK_ID=exp-wb-1
EXP_CONN_ID=exp-conn-1
