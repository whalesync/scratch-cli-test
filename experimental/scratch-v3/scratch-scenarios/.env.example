# Scratch Scenario Test Environment
# Copy to .env and fill in real values.
# Ask a teammate for credentials or run setup-airtable.py to generate.

# Airtable
AIRTABLE_TOKEN=patXXXXX.XXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TAGS_TABLE_ID=tblXXXXXXXXXXXXXX
AIRTABLE_AUTHORS_TABLE_ID=tblXXXXXXXXXXXXXX
AIRTABLE_POSTS_TABLE_ID=tblXXXXXXXXXXXXXX
AIRTABLE_PAGES_TABLE_ID=tblXXXXXXXXXXXXXX
AIRTABLE_PRODUCTS_TABLE_ID=tblXXXXXXXXXXXXXX

# WordPress
WP_URL=https://your-wordpress-site.example.com
WP_USER=your-username
WP_APP_PASSWORD="your app password"

# Scratch API (local servers)
SCRATCH_API_URL=http://localhost:8000
