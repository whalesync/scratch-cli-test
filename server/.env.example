# Should be: 'development' for local dev, 'test' and 'staging' for our cloud pre-production projects, and 'production'
# for our production environment.
NODE_ENV='development'

# Valid values: 'production', 'staging', 'test', 'development'. Overridden in .gitlab-ci.yml.
APP_ENV=development

# Valid values: api, worker, cron or monolith. 
# Monolith is only used in local environments and will run all services in a single server
SERVICE_TYPE=monolith

PORT=3010

# Connection to the database from prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#using-environment-variables
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scratchpad?schema=public"

# Enable debug logging for database queries (true/false)
DB_DEBUG=false

# Connection to Redis - used for BullMQ, snapshot pub/sub events and caching
REDIS_HOST=localhost
REDIS_PORT=6379
# only include if you have auth on your redis instance
# REDIS_PW=.....

# When true, API token requests are not rate limited (same as rate-limit:unlimited on every token). Default: false
API_RATE_LIMIT_DISABLED=false

# Configuration for auth
CLERK_PUBLISHABLE_KEY=pk_test_ZmFjdHVhbC1ndXBweS01NS5jbGVyay5hY2NvdW50cy5kZXYk
# See: https://dashboard.clerk.com/apps/app_2ymxByR3cEOiOZGKx91GRzHZQ3f/instances/ins_2ymxBtQskUovRqqMFxDlz8s4QNT/api-keys
CLERK_SECRET_KEY=<Get this from the Clerk Dashboard (Scratch Development App) or Chris>

# Settings for PostHog
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=<Get this from Posthog Dashboard>
POSTHOG_FEATURE_FLAG_API_KEY=<Get this from Posthog Dashboard>
# Defaults to true for deployed environments but must be manually set when using analytics in local development environments
# POSTHOG_ANALYTICS_ENABLED=false


# Settings for Stripe
STRIPE_API_KEY=fakekey
STRIPE_WEBHOOK_SECRET=fakesecret

# Settings for Slack notifications -- leave disabled when running locally
SLACK_NOTIFICATION_ENABLED=false
SLACK_NOTIFICATION_WEBHOOK_URL=<URL from Whalesync Devops Assistant: https://api.slack.com/apps/A089NSDDM35/incoming-webhooks?>

# Settings for Linear integration. Leave API key blank to disable linear SDK
LINEAR_API_KEY=
LINEAR_PROJECT_ID=
LINEAR_TEAM_ID=


# OpenRouter API key for AI sync builder feature (leave blank to disable)
OPENROUTER_API_KEY=

# LangSmith tracing (optional — set LANGCHAIN_TRACING_V2=true + LANGCHAIN_API_KEY to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=scratch-ai-sync-builder

# key used to encrypt secret connection credentials (OAuth tokens, API keys)
ENCRYPTION_MASTER_KEY=12345678901234567890123456789012

# OAuth Setup

# for dev environments set the URI to this so it matches the authorized 
# redirect URIs in the oauth configs for Google, Notion, and Webflow.
REDIRECT_URI=https://test.scratch.md/oauth/callback

# You only need to set these if you are testing the oauth providers directly in the local environment
NOTION_CLIENT_ID=fake_id
NOTION_CLIENT_SECRET=fake_key

WEBFLOW_CLIENT_ID=fake_id
WEBFLOW_CLIENT_SECRET=fake_key

GOOGLE_CLIENT_ID=fake_id
GOOGLE_CLIENT_SECRET=fake_key

SHOPIFY_CLIENT_ID=fake_id
SHOPIFY_CLIENT_SECRET=fake_key

SUPABASE_CLIENT_ID=fake_id
SUPABASE_CLIENT_SECRET=fake_key

AIRTABLE_CLIENT_ID=fake_id
AIRTABLE_CLIENT_SECRET=fake_key

QUICKBOOKS_CLIENT_ID=fake_id
QUICKBOOKS_CLIENT_SECRET=fake_key

LINEAR_OAUTH_CLIENT_ID=fake_id
LINEAR_OAUTH_CLIENT_SECRET=fake_key

# -------
# Feature Flags (eventually move these to LaunchDarkly or Posthog)
# -------
# whether or not the system users jobs for downloading table data
USE_JOBS=true

SCRATCH_GIT_API_URL=http://localhost:3100
SCRATCH_GIT_BACKEND_URL=http://localhost:3101

# Google Cloud Storage bucket for rehosted assets (optional — asset rehosting disabled if unset)
# GCS_ASSET_BUCKET=scratch-assets-dev

# WHALESYNC_API_URL=https://api.whalesync.com

# MCP OAuth — override URLs when testing with Claude Connectors via ngrok
# MCP_SERVER_URL=https://abc123.ngrok.io
# MCP_CLIENT_URL=https://def456.ngrok.io

# OpenTelemetry metrics (set to true in deployed environments via Terraform)
USE_OPENTELEMETRY_METRICS=false
# Build version identifier for OTel resource attributes (set by CI/CD pipeline)
# BUILD_VERSION=local