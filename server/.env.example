# Should be: 'development' for local dev, 'test' and 'staging' for our cloud pre-production projects, and 'production'
# for our production environment.
NODE_ENV='development'

# Valid values: 'production', 'staging', 'test', 'development'. Overridden in .gitlab-ci.yml.
APP_ENV=development

# Valid values: api, worker, cron or monolith. 
# Monolith is only used in local environments and will run all services in a single server
SERVICE_TYPE=monolith

PORT=3010

# Connection to the database from prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#using-environment-variables
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scratchpad?schema=public"

# Enable debug logging for database queries (true/false)
DB_DEBUG=false

# Connection to Redis - used for BullMQ, snapshot pub/sub events and caching
REDIS_HOST=localhost
REDIS_PORT=6379
# only include if you have auth on your redis instance
# REDIS_PW=.....

# When true, API token requests are not rate limited (same as rate-limit:unlimited on every token). Default: false
API_RATE_LIMIT_DISABLED=false

# Configuration for auth
CLERK_PUBLISHABLE_KEY=pk_test_ZmFjdHVhbC1ndXBweS01NS5jbGVyay5hY2NvdW50cy5kZXYk
# See: https://dashboard.clerk.com/apps/app_2ymxByR3cEOiOZGKx91GRzHZQ3f/instances/ins_2ymxBtQskUovRqqMFxDlz8s4QNT/api-keys
CLERK_SECRET_KEY=<Get this from the Clerk Dashboard (Scratch Development App) or Chris>

# Shared secret for the internal Whalesync admin channel (/internal/whalesync/*), validated by
# ScratchAdminGuard. Bottlenose presents it as the X-Scratch-Admin-Token header. In cloud this comes
# from GCP Secret Manager. Leave unset to disable the channel (the guard then denies all requests).
# SCRATCH_ADMIN_API_KEY=<generate a long random secret>
# Optional second secret accepted during a rotation window (set the new key here while rotating).
# SCRATCH_ADMIN_API_KEY_PREVIOUS=
# Comma-separated Whalesync (Dusky) browser origins allowed to call the Scratch API directly via CORS.
# Defaults to https://app.whalesync.com in production; set explicitly for dev/test/staging.
# WHALESYNC_APP_ORIGINS=http://localhost:3001

# Settings for PostHog
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=<Get this from Posthog Dashboard>
POSTHOG_FEATURE_FLAG_API_KEY=<Get this from Posthog Dashboard>
# Defaults to true for deployed environments but must be manually set when using analytics in local development environments
# POSTHOG_ANALYTICS_ENABLED=false


# Settings for Stripe
STRIPE_API_KEY=fakekey
STRIPE_WEBHOOK_SECRET=fakesecret

# Settings for Slack notifications -- leave disabled when running locally
SLACK_NOTIFICATION_ENABLED=false
SLACK_NOTIFICATION_WEBHOOK_URL=<URL from Whalesync Devops Assistant: https://api.slack.com/apps/A089NSDDM35/incoming-webhooks?>

# Settings for SendGrid email notifications (leave blank to disable)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=support@scratch.md

# Settings for Linear integration. Leave API key blank to disable linear SDK
LINEAR_API_KEY=
LINEAR_PROJECT_ID=
LINEAR_TEAM_ID=


# OpenRouter API key for AI sync builder feature (leave blank to disable)
OPENROUTER_API_KEY=

# Token for authenticating GitHub release lookups (DesktopReleaseService). Unauthenticated requests
# are limited to 60/hr per IP; an authenticated token gets 5,000/hr. Optional locally — only needs
# read access to the public release repos (a no-scope classic PAT or a read-only fine-grained token).
GITHUB_RELEASES_TOKEN=

# LangSmith tracing (optional — set LANGCHAIN_TRACING_V2=true + LANGCHAIN_API_KEY to enable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=scratch-ai-sync-builder

# key used to encrypt secret connection credentials (OAuth tokens, API keys)
ENCRYPTION_MASTER_KEY=12345678901234567890123456789012

# OAuth Setup

# for dev environments set the URI to this so it matches the authorized 
# redirect URIs in the oauth configs for Google, Notion, and Webflow.
REDIRECT_URI=https://test.scratch.md/oauth/callback

# You only need to set these if you are testing the oauth providers directly in the local environment
NOTION_CLIENT_ID=fake_id
NOTION_CLIENT_SECRET=fake_key

WEBFLOW_CLIENT_ID=fake_id
WEBFLOW_CLIENT_SECRET=fake_key

GOOGLE_CLIENT_ID=fake_id
GOOGLE_CLIENT_SECRET=fake_key

SHOPIFY_CLIENT_ID=fake_id
SHOPIFY_CLIENT_SECRET=fake_key

SUPABASE_CLIENT_ID=fake_id
SUPABASE_CLIENT_SECRET=fake_key

AIRTABLE_CLIENT_ID=fake_id
AIRTABLE_CLIENT_SECRET=fake_key

QUICKBOOKS_CLIENT_ID=fake_id
QUICKBOOKS_CLIENT_SECRET=fake_key

LINEAR_OAUTH_CLIENT_ID=fake_id
LINEAR_OAUTH_CLIENT_SECRET=fake_key

# HighLevel (GoHighLevel) Marketplace app. Client id/secret from the GHL Developer
# Marketplace app's "Settings" tab. The app-initiated flow's redirect URL must match
# REDIRECT_URI above (e.g. http://localhost:3000/oauth/callback for local).
#
# Marketplace-initiated ("inbound") OAuth install needs NO extra config: the marketplace
# redirects to the WEB page `<web app>/oauth/install/:slug` (which posts the code to the
# public `POST /oauth/install/:slug` endpoint), and the token exchange's redirect_uri
# derives from REDIRECT_URI's origin. Set the GHL listing's redirect URL to that web URL.
# NOTE: GHL rejects redirect URLs containing its brand ("highlevel"/"gohighlevel"/"ghl"), so
# GHL's inbound slug is `hl` (mapped back to the GOHIGHLEVEL provider server-side):
# https://app.scratch.md/oauth/install/hl
GOHIGHLEVEL_CLIENT_ID=fake_id
GOHIGHLEVEL_CLIENT_SECRET=fake_key

# -------
# Feature Flags (eventually move these to LaunchDarkly or Posthog)
# -------
# whether or not the system users jobs for downloading table data
USE_JOBS=true

SCRATCH_GIT_API_URL=http://localhost:3100
SCRATCH_GIT_BACKEND_URL=http://localhost:3101

# Google Cloud Storage bucket for rehosted assets (optional — asset rehosting disabled if unset).
# The bucket below is the test env's real bucket — run `gcloud auth application-default login`
# against the test project first.
# GCS_ASSET_BUCKET=spv1eu-test-assets

# Google Cloud Storage bucket for short-lived publish-patch uploads via /upload-patch
# (optional — endpoint returns 503 if unset). Must be a SEPARATE bucket from
# GCS_ASSET_BUCKET: patches contain user record data and the asset bucket is
# publicly readable. The bucket below is the test env's real bucket — run
# `gcloud auth application-default login` against the test project first.
# GCS_PATCH_UPLOAD_BUCKET=spv1eu-test-upload-patches

# Local-dev only: target service account to impersonate when generating V4
# signed URLs for /upload-patch. User ADC (`gcloud auth application-default
# login`) has no `client_email`, so the Storage SDK's default signer fails.
# Setting this routes signing through IAM `signBlob` against the target SA.
# Requires `roles/iam.serviceAccountTokenCreator` on the target SA. In Cloud
# Run, ADC is already the runtime SA — leave this unset there.
# GCS_LOCAL_SIGNING_SA=cloudrun-service-account@spv1eu-test.iam.gserviceaccount.com

# WHALESYNC_API_URL=https://api.whalesync.com
# WHALESYNC_APP_ORIGINS="http://localhost:3030,http://localhost:3000"

# MCP OAuth — override URLs when testing with Claude Connectors via ngrok
# MCP_SERVER_URL=https://abc123.ngrok.io
# MCP_CLIENT_URL=https://def456.ngrok.io

# Connector outbound HTTP logging (DEV-10339). Controls the shared request/response
# logging interceptor in createApiClient(). One of: off | basic | verbose (default basic).
#   - basic:   log method + URL + status + duration for every connector API call
#   - verbose: additionally log request headers (Authorization/token values masked)
#   - off:     do not install the interceptor at all
# Lines are emitted at `debug` level, so set LOG_LEVEL=debug to actually see them.
# CONNECTOR_HTTP_LOGGING=basic

# OpenTelemetry metrics (set to true in deployed environments via Terraform)
USE_OPENTELEMETRY_METRICS=false
# Build version identifier for OTel resource attributes (set by CI/CD pipeline)
# BUILD_VERSION=local