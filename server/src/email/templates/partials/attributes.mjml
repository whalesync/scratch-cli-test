<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="arial, helvetica, sans-serif" color="#000000" />
      <mj-section background-color="#FFFFFF" padding="0 50px" />
      <mj-text font-size="14px" line-height="22px" padding="0 0 18px 0" />
      <mj-button background-color="#F5F542" color="#000000" border="1px solid #333333" border-radius="6px" font-size="14px" font-weight="normal" inner-padding="12px 18px" align="center" padding="0 0 40px 0" />
    </mj-attributes>
  </mj-head>
</mjml>
