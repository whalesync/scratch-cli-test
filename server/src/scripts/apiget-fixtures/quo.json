{
  "apiType": "rest",
  "authHeader": { "style": "raw" },
  "endpoints": [
    {
      "id": "ep_quo_phone_numbers",
      "name": "Phone Numbers",
      "method": "GET",
      "url": "https://api.openphone.com/v1/phone-numbers",
      "overrides": {
        "paginationType": "cursor",
        "request": {
          "cursorParam": "pageToken",
          "limitParam": "maxResults",
          "maxPageSize": 50
        },
        "response": {
          "cursorPath": "nextPageToken",
          "dataPath": "data"
        }
      }
    },
    {
