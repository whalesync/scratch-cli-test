// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins", "nativeDistinct"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///
/// NOTE: Keep this in sync with packages/shared-types/src/enums
/// Begin "keep in sync" section
///

enum UserRole {
  USER
  ADMIN
}

enum AuthType {
  API_KEY // Deprecated
  OAUTH
  USER_PROVIDED_PARAMS
}

enum ConnectorHealthStatus {
  OK
  FAILED
}

enum ActionType {
  PUBLISH
}

enum RecordDeleteBehavior {
  DELETE
  IGNORE
}

enum SyncState {
  OFF
  ON
}

/// The external app that owns and manages a workbook, if any. A null
/// `Workbook.managedBy` means a standalone Scratch workbook (not managed by any
/// app); `ws_crm` means it is managed by Whalesync's CRM Mirror (via dusky),
/// which constrains its config.
enum WorkbookManager {
  ws_crm
}

///
/// End "keep in sync" section
///

model User {
  id                   String                @id // type: UserId
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  clerkId              String?               @unique // Real Clerk ID (user_…) for native users; synthetic "ws_<whalesyncUserId>" for Whalesync shadow users
  whalesyncUserId      String?               @unique // UUID of the linked Whalesync user; null for native Scratch users
  name                 String?
  /// Always stored lowercase + trimmed by a BEFORE INSERT/UPDATE trigger.
  email                String?               @unique
  role                 UserRole              @default(USER)
  stripeCustomerId     String?               @unique
  organizationId       String?
  organization         Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  settings             Json?                 @default("{}") // UserSettings object
  lastWorkbookId       String?
  lastWorkbook         Workbook?             @relation("UserLastWorkbook", fields: [lastWorkbookId], references: [id], onDelete: SetNull)
  waitlistApproved     Boolean               @default(false)
  apiTokens            ApiToken[]
  connectorAccounts    ConnectorAccount[]
  subscriptions        Subscription[]
  invoiceResults       InvoiceResult[]
  jobs                 DbJob[]
  workbooks            Workbook[]
  publishPlans         PublishPlan[]
  authoredPublishPlans PublishPlan[]         @relation("PublishPlanAuthor")
  schedules            Schedule[]
  workspacePermissions WorkspacePermission[]
  workspaceInvites     WorkspaceInvites[]
  mcpClients           McpClient[]
}

model ApiToken {
  id        String   @id // type: APITokenId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String
  createdAt DateTime @default(now())
  expiresAt DateTime @updatedAt
  type      String   @default("USER")
  scopes    String[] // Optional list of scopes for the token like 'read:snapshots', 'write:snapshots', ...

  @@unique([token])
  @@index([userId])
  @@map("APIToken")
}

model McpClient {
  id           String   @id // type: McpClientId
  clientId     String   @unique
  clientName   String?
  redirectUris String[]
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId       String?
}

///
/// NOTE: Keep this in sync with packages/shared-types/src/db/connector-account.ts
/// Begin "keep in sync" section
///

model ConnectorAccount {
  id                        String                 @id // type: ConnectorAccountId
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  user                      User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId                    String?
  workbookId                String
  workbook                  Workbook               @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  service                   String
  displayName               String
  authType                  AuthType               @default(USER_PROVIDED_PARAMS)
  repoPath                  String?
  encryptedCredentials      Json                   @default("{}") // Encrypted JSON containing apiKey, oauth tokens, etc.
  healthStatus              ConnectorHealthStatus?
  healthStatusLastCheckedAt DateTime?
  healthStatusMessage       String? // Message if health status is not OK
  modifier                  String? // ID of the custom connector or other modifier entity
  extras                    Json? // Additional service-specific configuration
  version                   Int                    @default(1) // Connector code version snapshotted at creation (DEV-10302)
  // Set while a code-migration is quiescing this connection (DEV-9698 T4). Non-null = the
  // connection is locked: live edits + new job enqueues for it are rejected with 409, and a
  // re-run (or the migration's own release in `finally`) clears it. The timestamp records when
  // the lock was taken (aids stale-lock debugging). NOT an auto-expiring lock — strict by design.
  migrationLockedAt         DateTime?
  dataFolders               DataFolder[]
  publishPlans              PublishPlan[]

  @@index([userId])
  @@index([workbookId])
  @@index([migrationLockedAt])
}

///
/// End "keep in sync" section
///

/// Pending (orphan) OAuth tokens from a marketplace-initiated ("inbound") install,
/// held until an authenticated Scratch user claims them. Connector-agnostic: keyed
/// by `service`, so any OAuth connector (GoHighLevel, Webflow, …) reuses it.
/// Server-only — not a shared wire type. The `id` IS the unguessable installId and
/// is treated as a bearer secret: single-use (deleted on claim) and short-TTL (rows
/// past `expiresAt` are rejected on claim; the `@@index([expiresAt])` supports a
/// future periodic cleanup sweep of orphaned rows).
model PendingOAuthInstall {
  id                   String    @id // the unguessable installId — bearer secret
  createdAt            DateTime  @default(now())
  expiresAt            DateTime // now + TTL; rows past this are rejected on claim
  service              String // connector service key, e.g. "GOHIGHLEVEL"
  encryptedCredentials Json // same AES-256-GCM envelope as ConnectorAccount.encryptedCredentials
  workspaceId          String? // tokenResponse.workspace_id (e.g. GHL locationId) — for the connector + claim UI
  displayName          String? // human label for the claim page (best-effort)
  claimedByUserId      String? // set atomically at claim time, just before the row is deleted
  claimedAt            DateTime?

  @@index([expiresAt])
}

///
/// NOTE: Keep this in sync with packages/shared-types/src/db/workbook.ts
/// Begin "keep in sync" section
///

model Workbook {
  id        String   @id // type: WorkbookId
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(2)

  // True once a user has requested deletion. The async hard-delete worker removes the row when complete.
  isPendingDelete Boolean @default(false)

  // Which external app owns and manages this workbook, if any. `null` means a
  // standalone Scratch workbook (not managed by any app). `ws_crm` means it is
  // managed by Whalesync's CRM Mirror (via dusky), which constrains its config.
  managedBy WorkbookManager?

  // Arbitrary client-supplied config metadata as a flat key/value map. Patched via a
  // merge (null values delete keys), never wholesale-replaced. See WorkbookSettings.
  settings Json? @default("{}") // WorkbookSettings object

  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dataFolders          DataFolder[]
  connectorAccounts    ConnectorAccount[]
  usersWithAsDefault   User[]                @relation("UserLastWorkbook")
  publishPlans         PublishPlan[]
  schedules            Schedule[]
  syncs                Sync[]
  syncDrafts           SyncDraft[]
  assets               Asset[]
  routineRuns          RoutineRun[]
  workspacePermissions WorkspacePermission[]
  workspaceInvites     WorkspaceInvites[]

  @@index([userId])
  @@index([organizationId])
}

///
/// End "keep in sync" section
///

model WorkspacePermission {
  id         String   @id // type: WorkspacePermissionId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  workbookId String
  role       String   @default("editor")

  @@unique([userId, workbookId])
  @@index([userId])
  @@index([workbookId])
}

model WorkspaceInvites {
  id         String   @id // type: WorkspaceInvitesId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  /// Always stored lowercase + trimmed by a BEFORE INSERT/UPDATE trigger.
  email      String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  workbookId String
  role       String   @default("editor")

  userId String? // the user that created the invite  
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([email, workbookId])
  @@index([email])
  @@index([workbookId])
}

/// A user's subscription with stripe.
/// There *should* only ever be one of these for a user, but we track any subscriptions stripe sends our way.
model Subscription {
  id                   String       @id // type: SubscriptionId
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  version              Int          @default(1)
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId               String // the subscription must be assocated with a user that has the customer ID in Stripe
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planType             String       @default("NOT_MIGRATED") // values should match the the ScratchPlanType enum
  stripeSubscriptionId String       @unique
  expiration           DateTime
  priceInDollars       Int          @default(0)
  stripeStatus         String?
  cancelAt             DateTime? // set when the user has cancelled the subscription and the date it takes effect
  lastInvoicePaid      Boolean? /// Set when we receive invoice.paid or invoice.payment_failed webhooks.

  @@index([userId])
  @@index([organizationId])
}

/// Simple log to cache whether a user's subscription is getting paid.
/// Stripe is the authoritative source for this.
model InvoiceResult {
  id        String   @id // type: InvoiceResultId
  createdAt DateTime @default(now())

  /// Stripe invoice ID
  invoiceId String

  /// The user that the invoice is for.
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // True if the invoice was paid.
  succeeded Boolean

  @@index([userId])
  @@index([organizationId])
  @@index([invoiceId])
}

model DbJob {
  id        String  @id // type: JobId
  bullJobId String? // BullMQ job ID for tracking

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  progress          Json? // Job progress data
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  workbookId        String? // Optional workbook association for filtering
  dataFolderId      String? // Optional data folder association for filtering
  status            String
  type              String
  data              Json // Job-specific data
  result            Json? // Job result data
  error             String? // Error message if failed
  processedOn       DateTime? // When job actually started processing
  finishedOn        DateTime? // When job completed (success or failure)
  cancelRequestedAt DateTime? // When cancellation was requested (checked by worker checkpoints)
  runId             String? // A grouping ID that links jobs that are part of the same run. use RunId type. Just used for indexing and filtering
  runContext        Json? // The context of the run that triggered this job, use RunContext type.
  syncId            String? // Optional sync association for filtering

  @@index([userId])
  @@index([workbookId])
  @@index([dataFolderId])
  @@index([runId])
  @@index([status])
  @@index([type])
  @@index([syncId])
  @@map("Job")
}

///
/// NOTE: Keep this in sync with packages/shared-types/src/db/audit-log-event.ts
/// Begin "keep in sync" section
///

model AuditLogEvent {
  id             String   @id // type: AuditLogEventId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  userId         String? // user who triggered the event, don't use FK for this field
  organizationId String? // organization that owns the entity that was affected by this event, don't use FK for this field
  message        String // message describing the event
  eventType      String // create, update, delete, publish, etc.
  entityId       String // ID of the entity that was affected by this event like a workbook or connection
  context        Json? // Additional details about the event that can be used to to show what changed or store additional context

  @@index([userId])
  @@index([organizationId])
  @@index([entityId])
}

// DataFolder: An entity representing a collection of related files
// Two types of DataFolder:
//  - Linked Folder: A folder that is attached to a data source via a connectorAccount with a schema
//  - Scratch Folder: A folder that contains "local" folders for the user, not attached to an external data source
model DataFolder {
  id        String   @id // type: DataFolderId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A display name for the table, provided by the user or sourced from the data source table
  name String

  // Workbook ownership
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  workbookId String

  // Optional connector account link
  connectorAccount   ConnectorAccount? @relation(fields: [connectorAccountId], references: [id], onDelete: SetNull)
  connectorAccountId String?

  // Service type (required when linked to a connector, optional otherwise)
  connectorService String?

  // Path of this folder in the File Store that contains the actual files
  path String?

  // Deep link to this table in the external service's own web UI (a URL on THEIR
  // site, e.g. https://airtable.com/{baseId}/{tableId}), for an "open in {service}"
  // link in the client. Connector-populated during schema building; null when the
  // service has no constructible deep link.
  remoteWebUrl String?

  // Denormalized count of record files in this folder: direct-child, non-dotfile blobs on
  // the `main` branch of the folder's git repo (matches what the folder viewer shows).
  // Sourced from git (NOT FileIndex) and refreshed after a pull and by an hourly cron, so
  // it may briefly lag UI edits/syncs/remote-deletes between refreshes. Workbook totals are
  // summed from this column on read (no Workbook column).
  recordCount Int @default(0)

  // When recordCount was last recomputed; null until the first pull/cron computes it.
  recordCountUpdatedAt DateTime?

  // Lock indicating an operation in progress: "pull", "publish", or null
  lock String?

  // Timestamp of the last successful sync (pull or publish)
  lastSyncTime DateTime?

  // Version number of the folder structure, to help with future migrations
  version Int @default(1)

  syncsPairsAsSource      SyncTablePair[]        @relation("sourceDataFolder")
  syncsPairsAsDestination SyncTablePair[]        @relation("destinationDataFolder")
  foreignKeyRecords       SyncForeignKeyRecord[]
  remoteIdMappings        SyncRemoteIdMapping[]
  assets                  Asset[]
  // publishPipelines        PublishPipeline[] // REMOVED in V2 refactor (scoped to ConnectorAccount)

  // Table ID path for connectors that represent tables as a path (e.g., ["database", "schema", "table"])
  // Empty array for scratch folders, populated for linked folders
  tableId String[] @default([])

  // True when the table schema has the x-scratch-asset-table flag,
  // meaning its records ARE assets (e.g. WordPress media, Webflow Assets).
  isAssetTable Boolean @default(false)

  // Additional options for interacting with the connector
  // Will be an object matching the DataFolderOptions interface, plus any connector-specific keys.
  options Json? @default("{}")

  // High-water mark for incremental polling. Null = never bootstrapped; the next pull will run as a full scan.
  lastIncrementalPullAt DateTime?

  // Connector-opaque change token used as an alternative to lastIncrementalPullAt for APIs that return change tokens.
  incrementalCursor Json? @db.Json

  // Timestamp of the last successful full pull. Tracked separately so full and incremental schedules don't shadow each other.
  lastFullPullAt DateTime?

  @@index([workbookId])
  @@index([connectorAccountId])
  @@index([path])
}

///
/// End "keep in sync" section
///

///
/// NOTE: Keep this in sync with packages/shared-types/src/db/organization.ts
/// Begin "keep in sync" section
///

model Organization {
  id        String   @id // type: OrganizationId
  clerkId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  deleted   Boolean  @default(false) // a soft delete flag for orgs to allow for async cleanup

  users                       User[]
  workbooks                   Workbook[]
  subscriptions               Subscription[]
  invoiceResults              InvoiceResult[]
  actions                     Action[]
  schedules                   Schedule[]
  organizationMonthlyRunCounts OrganizationMonthlyRunCount[]
}

///
/// End "keep in sync" section
///

/// Authorization codes for CLI login flow (similar to gcloud auth login)
model AuthorizationCode {
  id        String   @id // type: AuthorizationCodeId
  createdAt DateTime @default(now())
  expiresAt DateTime

  // The short user code displayed in CLI and entered by user in browser (e.g., "ABCD-1234")
  userCode String @unique

  // The longer code used by CLI to poll for authorization status
  pollingCode String @unique

  // Authorization status
  status String @default("pending") // "pending" | "approved" | "denied" | "expired"

  // Once approved, link to the user who authorized it
  userId String?

  // The generated API token (set when approved)
  apiToken String?

  @@index([userCode])
  @@index([pollingCode])
  @@index([expiresAt])
}

/// org's actions that are billable and we need to account for.
model Action {
  id             String       @id // type: ActionId
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String // User who initiated the action (no FK to avoid orphans)
  actionType     ActionType
  metadata       Json? // Dynamic data per action type

  @@index([organizationId, actionType, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

/// Monthly per-organization tally of high-level run executions, by type — a monetization lever
/// (parent epic DEV-10520). One row per (organization, calendar-month-UTC, runType). Counts roll
/// over by month (a new month = new rows) and past months are retained as history. Incremented
/// atomically when a run reaches a terminal, non-cancelled state (completed or failed); user
/// cancellations are not counted. A routine and the pull/sync/publish step jobs it runs each count
/// in their own type bucket AND in `routine` (the per-type slices intentionally overlap).
///
/// Deliberately NOT the `Action` table, which is row-per-action and slated for deprecation. These
/// counts are org-scoped and survive workbook deletion; only organization deletion cascades them
/// away. `runType` holds a RunType enum value ('pull' | 'publish' | 'sync' | 'routine').
model OrganizationMonthlyRunCount {
  id             String       @id // type: OrganizationMonthlyRunCountId
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// First instant of the calendar month in UTC (e.g. 2026-06-01T00:00:00.000Z).
  periodStart    DateTime
  /// RunType enum value: 'pull' | 'publish' | 'sync' | 'routine'.
  runType        String
  count          Int          @default(0)

  @@unique([organizationId, periodStart, runType])
  @@index([organizationId, periodStart])
}

// Tracks mapping between Git files and External Service IDs
model FileIndex {
  id         String    @id @default(cuid())
  workbookId String // Maps to gitBucket/repoId
  folderPath String
  recordId   String
  filename   String
  lastSeenAt DateTime?

  @@unique([workbookId, folderPath, recordId])
  @@index([workbookId, folderPath, filename])
  @@index([workbookId, folderPath, lastSeenAt])
}

// Tracks dependencies between files
model FileReference {
  id                  String  @id @default(cuid())
  workbookId          String
  sourceFilePath      String // The file containing the reference
  targetRemoteTableId String? // The remote table ID from the FK schema (e.g. Airtable table ID)
  targetRemoteId      String? // The remote record ID value from the FK field
  branch              String // "main" or "dirty/..."

  @@index([workbookId, targetRemoteTableId, targetRemoteId])
  @@index([workbookId, sourceFilePath, branch])
}

// Per-path metadata attached to patches uploaded via `/upload-patch/commit`.
// The dirty branch carries file content only; flags like `revert: true` that
// arrive on the upload-patch wire DTO need a sidecar persistence so they
// survive until the publish plan is built (which is what consumes them — see
// PublishPlanOperation.isRecreate). One row per path; upserted on each
// upload (the last upload's flag wins). Cleared after the publish that
// consumed the flagged paths settles; also cleared on workbook delete.
//
// Scoped per (workbookId, connectorAccountId, filePath). The publish flow
// looks up metadata by exact (workbook, account, path) tuple.
model UploadPatchMeta {
  id                 String   @id @default(cuid())
  workbookId         String
  connectorAccountId String
  filePath           String
  // True when the patch was produced by `scratchmd files revert-plan`.
  // PublishPlanBuildService propagates this onto PublishPlanOperation
  // (isRecreate), which dispatchUpdateBatch reads to gate FK rewrite
  // against RecreatedIdMap.
  revert             Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@unique([workbookId, connectorAccountId, filePath])
}

// Maps a deleted record's prior remote id to the new remote id it was assigned
// when the user reverted the delete and republished. Written by the publish job
// after a successful recreate (triggered by a `scratch_pending_recreate_<old_id>`
// sentinel in the create payload). Read at publish time to rewrite FK fields on
// other records being recreated, so a sibling revert that referenced the old id
// resolves to the new id instead of dangling.
//
// Scoped per (workbookId, connectorAccountId, folder) because each
// connector + table has its own id space. Transitive lookups (a recreated
// record itself getting deleted-and-recreated again) walk the chain via the
// secondary index on newRemoteId.
//
// Lifecycle: never pruned in v1; cleanup ties to WorkbookService.delete and
// ConnectorAccountService cleanup (see workbook.service.ts pattern for
// FileIndex / FileReference).
model RecreatedIdMap {
  id                 String   @id @default(cuid())
  workbookId         String
  connectorAccountId String
  folder             String
  priorRemoteId      String
  newRemoteId        String
  settledAt          DateTime @default(now())

  @@unique([workbookId, connectorAccountId, folder, priorRemoteId])
  @@index([workbookId, connectorAccountId, folder, newRemoteId])
}

model PublishPlan {
  id        String   @id // type: PublishPlanId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workbookId String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The user who initiated this publish. Populated at plan creation from the
  // current actor. Nullable so that scheduled / automated publishes (no user
  // context) can leave it empty.
  authorId String?
  author   User?   @relation("PublishPlanAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  status     String // "planned", "building", "ready", "failed", "running", "completed"
  branchName String

  // SHA of dirty HEAD captured before the publish work began. The user's local
  // edits that the publish is about to apply. Mirrors the `dirty_plan_{id}` git tag.
  preDirtyCommitSha String?
  // SHA of main HEAD captured before the publish work began. The canonical state
  // the publish is changing. Mirrors the `main_pre_plan_{id}` git tag. The primary
  // diff on the publish history detail page is (preMainCommitSha → preDirtyCommitSha) —
  // i.e. what was about to be published when the plan ran.
  preMainCommitSha  String?
  // SHA of main HEAD captured after a successful run (including completed-with-errors).
  // What got shipped. Mirrors the `main_plan_{id}` git tag. Kept for reference /
  // rollback; not used in the primary diff.
  postMainCommitSha String?

  result Json? @db.Json

  activeJobId String? // BullMQ job ID of the currently active plan or run job

  connectorAccount   ConnectorAccount? @relation(fields: [connectorAccountId], references: [id])
  connectorAccountId String?

  operations PublishPlanOperation[]

  @@index([workbookId])
  @@index([userId])
  @@index([connectorAccountId])
}

model PublishPlanOperation {
  id     String      @id @default(cuid())
  planId String
  plan   PublishPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  filePath String // The logical path of the file

  phase   String // "create", "edit", "delete", "backfill"
  content Json?  @db.Json // The content of the file that we will push at this phase

  changedFields Json? @db.Json // Only the fields that changed (edit/backfill phases only)

  remoteRecordId String? // The remote record ID (set for delete entries)
  remoteTableId  String? // DEPRECATED: usage removed, column to be dropped in future migration
  dataFolderId   String? // The DataFolder ID (for batching)
  status         String  @default("pending") // "pending", "success", "failed-batch"
  error          String?

  // True when this operation was produced from a `scratchmd files revert-plan`
  // patch (CLI sent `revert: true` on the upload-patch DTO, which
  // ApplyPatchesService persisted to UploadPatchMeta, which
  // PublishPlanBuildService joined here at plan-build time). Read by
  // dispatchUpdateBatch + dispatchCreateBatch to gate FK rewrite against
  // RecreatedIdMap — only revert-originated edits get their FK literals
  // remapped; ordinary user edits reflect direct intent and are left alone.
  // (Note: creates also detect "is recreate" via the
  // scratch_pending_recreate_<old_id> sentinel in the PK field. The flag and
  // the sentinel agree by construction; either one suffices for creates.
  // For updates the flag is the only signal — diffs don't carry a sentinel.)
  isRecreate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([planId, phase, status])
  @@index([planId, dataFolderId])
}

//#region Sync

/// Represents a one-way sync between two DataFolders
model Sync {
  id           String   @id // type: SyncId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  displayName  String
  displayOrder Int      @default(0) @db.SmallInt

  workbookId String?
  workbook   Workbook? @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  // Frozen as v1 source of truth from the moment `mappingsV2` is first written.
  // Reads route through `SyncService.getMappings()`/`getSync()` — the ESLint
  // rule on `prisma.sync.find*` defends the choke point.
  mappings   Json // SyncMappingV1 — @see packages/shared-types/src/sync-mapping.ts
  // Orphan-aware v2 shape. Preferred over `mappings` once non-null.
  // TODO(DEV-10008): final cleanup migration drops the v1 column and renames
  // `mappingsV2 → mappings`.
  mappingsV2 Json? // SyncMappingV2 — @see packages/shared-types/src/sync-mapping.ts

  /// Whether the sync is enabled.
  syncState            SyncState @default(OFF)
  /// The time the sync state was changed last.
  syncStateLastChanged DateTime?
  /// The time the most recent full sync was run.
  lastSyncTime         DateTime?

  /// Whether to automatically trigger a publish after a successful sync.
  publishAfterSync Boolean @default(false)

  syncTablePairs    SyncTablePair[]
  foreignKeyRecords SyncForeignKeyRecord[]
  remoteIdMappings  SyncRemoteIdMapping[]
}

model SyncTablePair {
  id        String   @id // type: SyncId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sync   Sync   @relation(fields: [syncId], references: [id], onDelete: Cascade)
  syncId String

  sourceDataFolder   DataFolder @relation("sourceDataFolder", fields: [sourceDataFolderId], references: [id], onDelete: Cascade)
  sourceDataFolderId String

  destinationDataFolder   DataFolder @relation("destinationDataFolder", fields: [destinationDataFolderId], references: [id], onDelete: Cascade)
  destinationDataFolderId String
}

model SyncMatchKeys {
  id String @id @default(cuid())

  // Intentionally without FKs here, because we only need this table as a dumb unique index
  syncId       String
  dataFolderId String
  matchId      String
  remoteId     String // The remote ID of the record (from file content)
  filePath     String @default("") // The file path of the record in git

  @@unique([syncId, dataFolderId, matchId])
  @@index([syncId, matchId])
}

/// Caches JSON data of records referenced by foreign keys in source records.
/// For example, if a Post has category_id: "cat_123", this stores the Category record data.
model SyncForeignKeyRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sync   Sync   @relation(fields: [syncId], references: [id], onDelete: Cascade)
  syncId String

  dataFolder   DataFolder @relation(fields: [dataFolderId], references: [id], onDelete: Cascade)
  dataFolderId String

  /// The foreign key value (remote ID of the referenced record)
  foreignKeyValue String

  /// JSON representation of the referenced record
  recordData Json @db.Json

  @@unique([syncId, dataFolderId, foreignKeyValue])
  @@index([syncId])
  @@index([dataFolderId])
}

/// Maps source remote IDs to destination remote IDs for synced records.
model SyncRemoteIdMapping {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sync   Sync   @relation(fields: [syncId], references: [id], onDelete: Cascade)
  syncId String

  dataFolder   DataFolder @relation(fields: [dataFolderId], references: [id], onDelete: Cascade)
  dataFolderId String

  /// The remote ID of the record in the source system
  sourceRemoteId String

  /// The remote ID of the corresponding record in the destination system (nullable for unmatched source records)
  destinationRemoteId String?

  /// The file path of the corresponding record in the destination system (nullable for unmatched source records)
  destinationFilePath String?

  @@unique([syncId, dataFolderId, sourceRemoteId])
  @@index([syncId])
  @@index([dataFolderId])
}

/// A transient, desired-state working copy used to provision (or edit) a Sync —
/// including tables/fields to create on a remote service — before it is applied.
/// Spans the two-phase saga: the reconciler input for apply (Phase 2) and the
/// checkpoint that makes materialize (Phase 1) retryable. Archived (not deleted)
/// after apply for debugging.
/// @see packages/shared-types/src/db/sync-draft.ts
model SyncDraft {
  id        String   @id // type: SyncDraftId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workbookId String
  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)

  /// Optimistic-concurrency token, bumped on every write. PATCH echoes the
  /// version it edited; a mismatch is a 409.
  version Int @default(1)

  displayName  String
  /// Cron expression mirroring SaveSyncBody.schedule, or null for no schedule.
  schedule     String?
  /// Set when initialized from an existing sync (edit flow); apply diffs against it.
  sourceSyncId String?

  /// Whether apply should configure the resulting Sync to auto-publish after a
  /// successful sync (mirrors SaveSyncBody.publishAfterSync).
  publishAfterSync Boolean @default(false)

  /// The desired-state working copy: DraftTableMapping[].
  /// @see packages/shared-types/src/dto/sync-draft/sync-draft-content.ts
  tableMappings Json

  /// Set once applied — an archived draft is never edited or re-applied.
  archivedAt    DateTime?
  /// The Sync produced by apply (set alongside archivedAt).
  appliedSyncId String?

  @@index([workbookId])
}

//#endregion

//#region Schedule

/// A user-defined schedule that triggers pull, publish, or sync jobs on a cron expression.
model Schedule {
  id        String   @id // type: ScheduleId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  workbookId String

  /// This was added so jobs can be run under the organization that owns the workbook
  /// Once jobs are moved to using system actors, this can be removed.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// The user who created this schedule. SetNull on delete so the schedule keeps running.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  /// Human-readable label, e.g. "Hourly Airtable pull"
  name String

  /// The operation to perform: PULL, PUBLISH, SYNC, or a connection-wide pull.
  /// Plain String (no DB enum); the allowed values are the `ScheduleAction` const in @spinner/shared-types.
  action String

  /// Polymorphic reference to the target entity: DataFolderId for PULL/FULL_PULL/INCREMENTAL_PULL/PUBLISH,
  /// SyncId for SYNC, ConnectorAccountId for CONNECTION_FULL_PULL/CONNECTION_INCREMENTAL_PULL.
  /// No FK constraint — validated at the application level.
  entityId String

  /// Cron expression (standard 5-field: minute hour dom month dow)
  cronExpression String

  /// IANA timezone (e.g. "America/New_York") the cron's wall-clock time is interpreted in,
  /// or null for UTC. Only set for time-based frequencies (daily/weekly/monthly); interval
  /// and manual schedules are timezone-invariant and leave this null. Passed to cron-parser's
  /// `tz` option when computing nextRunAt so the schedule tracks DST (DEV-10569).
  timezone String?

  /// Whether this schedule is active. Disabled schedules are not evaluated.
  enabled Boolean @default(true)

  /// Set when the Webflow folder-restructure (or any future connection-quiesce) migration
  /// disabled this schedule, so a crashed run can re-enable exactly the schedules IT disabled
  /// without re-enabling ones the user disabled themselves (DEV-9698 T4, finding #11). The
  /// restore step is driven entirely off this marker, so it repairs schedule state on re-run
  /// even after the in-memory prior-state map is lost to a crash. Null in normal operation.
  disabledForMigrationAt DateTime?

  /// The last time this schedule fired (successfully enqueued a job).
  lastTriggeredAt DateTime?

  /// The next calculated fire time. Updated after each trigger or cron expression change.
  nextRunAt DateTime?

  @@unique([workbookId, action, entityId])
  @@index([workbookId])
  @@index([enabled, nextRunAt])
  @@index([entityId])
}

//#endregion

//#region Routine

/// Execution history for a single run of a routine (a file-defined workflow pipeline).
/// The routine *definition* is never stored in the DB — it lives as a YAML file in the
/// workbook config repo under routines/. Only run history is persisted here.
/// NOTE: Keep this in sync with packages/shared-types/src/db/routine-run.ts
model RoutineRun {
  id        String   @id // type: RoutineRunId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  workbookId String

  /// The routine file path, e.g. "routines/daily-sync.yaml".
  /// Stored here so run history is readable even if the file is later deleted.
  routineFilePath String

  /// The routine name at the time of this run (snapshot from YAML).
  routineName String

  /// "pending" | "running" | "completed" | "failed" | "cancelled"
  status String @default("pending")

  /// Which trigger started this run: "manual" | "schedule"
  trigger String

  /// User who triggered the run (null for schedule-triggered runs).
  triggeredByUserId String?

  startedAt  DateTime?
  finishedAt DateTime?

  /// @deprecated Prefer `resultSummary`. Kept for backward-compat: still written (with the prefixed
  /// "Step N (action) failed: …" message) when a run fails. New UI should read `resultSummary`.
  error String?

  /// User-facing summary of the LAST step that ran — overwritten as each step finishes (a concise
  /// success summary, or the failed step's clean error). Null until the first step finishes.
  resultSummary String?

  /// Set when a run COMPLETES (not fails) but at least one step finished "completed with a warning"
  /// (a completed step with a non-null `error`, e.g. a publish whose connector rejected some records).
  /// Holds the first such step's message. Distinct from `error` (which means the run failed) so a
  /// consumer can tell "succeeded clean" (null) from "succeeded with warnings" (non-null) without
  /// walking the steps. Null on a clean run.
  resultWarning String?

  /// Index of the step currently executing (0-based).
  currentStepIndex Int @default(0)

  steps RoutineRunStep[]

  // NOTE: a PARTIAL UNIQUE INDEX enforces "one active run per routine file" —
  //   UNIQUE (workbookId, routineFilePath) WHERE status IN ('pending','running')
  // Prisma cannot express a partial (WHERE) index declaratively, so it is created by
  // raw SQL in the migration (see migrations/.../add_routine_active_run_index). A
  // concurrent trigger that races a live run hits P2002, which RoutineExecutorService
  // maps to a 409. Keep this comment in sync with that migration.
  @@index([workbookId])
  @@index([routineFilePath])
  @@index([status])
}

/// Per-step execution record within a RoutineRun.
/// NOTE: Keep this in sync with packages/shared-types/src/db/routine-run.ts
model RoutineRunStep {
  id        String   @id // type: RoutineRunStepId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run   RoutineRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId String

  /// 0-based position in the routine's step list.
  stepIndex Int

  /// The action type: "pull" | "sync" | "publish-plan" | "publish".
  action String

  /// The step's human-readable name (snapshot of the routine YAML step's `name:`). Unique within the
  /// routine when set. Null when the step has no name. Surfaced over the wire as `displayName`.
  name String?

  /// Target folder path for a single-folder action (publish / publish-plan). Null on pull steps,
  /// which list their targets in `folders` instead.
  folder String?

  /// Target folder paths for a `pull` step (snapshot of the step's `folders:` list — each a POSIX
  /// path or a DataFolderId). Empty for non-pull steps and for a pull step that omits `folders`
  /// (which then pulls all linked folders, optionally scoped by `connection`).
  folders String[]

  /// Target connection name or id (if specified on the step).
  connection String?

  /// For `sync` steps: the SyncId that ran (snapshot from the step's `sync:` field). Null for other actions.
  sync String?

  /// The step's timeout in seconds (snapshot from the step's `timeout:` field). Null = use the
  /// per-action default. Snapshotted so the executor never re-reads a since-edited routine file.
  timeoutSeconds Int?

  /// Action-specific config snapshot from the step's `options:` map (e.g. `{ "fullPull": true }` for
  /// a pull step). A single JSON column so new per-action options don't each need a dedicated column.
  /// Snapshotted so the executor never re-reads a since-edited routine file. Null when none are set.
  options Json?

  /// "pending" | "running" | "completed" | "failed" | "skipped"
  status String @default("pending")

  startedAt  DateTime?
  finishedAt DateTime?

  /// Error message if this step failed.
  error String?

  /// Reference to the DbJob created for this step (if applicable). No FK — DbJob.id is a string.
  jobId String?

  /// For publish-plan / publish steps: the PublishPlan pipeline created for this step.
  /// Lets a staged (plan-only) publish be located from run history. Null for other actions.
  pipelineId String?

  /// Normalized headline result computed from the step's job `publicProgress` when it completes — a
  /// concise `summary` plus flat `stats` counters (shape: RoutineRunStepResult in @spinner/shared-types).
  /// Persisted so it survives the job aging out of retention. Null until the step finishes.
  result Json?

  @@unique([runId, stepIndex])
  @@index([runId])
}

//#endregion

//#region Asset

/// Tracks file/media assets extracted from record files during pull.
/// Each row represents a unique asset within a workbook.
model Asset {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workbook   Workbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  workbookId String

  dataFolder   DataFolder? @relation(fields: [dataFolderId], references: [id], onDelete: SetNull)
  dataFolderId String?

  service       String // AIRTABLE, NOTION, WEBFLOW, etc.
  remoteAssetId String // Stable ID per connector (e.g. Airtable attachment id, URL hash, etc.)

  url          String? // Current URL (may be expired)
  filename     String?
  mimeType     String?
  size         BigInt? // Bytes
  width        Int? // Pixels
  height       Int? // Pixels
  altText      String?
  mediaType    String? // image | video | audio | document | file | external_video | model_3d
  urlExpiresAt DateTime? // When URL expires (null = permanent)
  lastSeenAt   DateTime? // Updated each pull; stale = deleted upstream
  rehostedUrl  String? // Permanent GCS URL
  rehostedAt   DateTime? // When rehosted
  contentHash  String? // SHA-256 hash of file content
  uploadedAt   DateTime? // When uploaded to destination connector

  /// Points to the source Asset this was created from during sync (null for pulled assets)
  sourceAsset   Asset?  @relation("AssetSyncLink", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  sourceAssetId String?

  /// Destination assets created from this source asset
  derivedAssets Asset[] @relation("AssetSyncLink")

  @@unique([workbookId, dataFolderId, remoteAssetId])
  @@unique([sourceAssetId, dataFolderId])
  @@index([workbookId, service])
  @@index([dataFolderId])
  @@index([urlExpiresAt])
  @@index([workbookId, lastSeenAt])
  @@index([sourceAssetId])
  @@index([contentHash])
}

//#endregion
