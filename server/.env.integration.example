# See: https://dashboard.clerk.com/apps/app_2ymxByR3cEOiOZGKx91GRzHZQ3f/instances/ins_2ymxBtQskUovRqqMFxDlz8s4QNT/api-keys
CLERK_SECRET_KEY=<Get this from the Clerk Dashboard (Scratch Development App) or Chris>
INTEGRATION_TEST_USER_ID=user_EXAMPLE
INTEGRATION_TEST_CLIENT_DOMAIN=localhost:3000
INTEGRATION_TEST_API_DOMAIN=localhost:3010
# Optional

# Set the key to match the running server's SCRATCH_ADMIN_API_KEY
SCRATCH_ADMIN_API_KEY=
# Set to true to run the integration tests
RUN_WHALESYNC_INTEGRATION=false

# Directs the test to use a specific workbook for the test
INTEGRATION_TEST_WORKBOOK_ID=
# Directs the test to use a specific table for the test, must be associated with the workbook above
INTEGRATION_TEST_TABLE_ID=

# Brevo API key for testing.
BREVO_API_KEY=

# Stripe — secret API key for connector integration tests (sk_test_... recommended)
STRIPE_CONNECTOR_API_KEY=

# Intercom — access token from a Developer Hub app (for intercom-connector integration tests)
INTERCOM_ACCESS_TOKEN=
# Optional — admin ID for creating articles. Auto-discovered from existing articles if not set.
INTERCOM_TEST_AUTHOR_ID=

# Notion — internal-integration token (ntn_... or legacy secret_...) for notion-connector integration tests.
# See server/test/integration/notion-setup.md for the one-time workspace setup.
NOTION_API_KEY=

# Webflow - test API key is in 1Password under testing@whalesync.com.
WEBFLOW_API_KEY=
# Optional (webflow-connector-assets): point the Image-field asset tests at a specific
# CMS collection that has a single Image field (otherwise one is auto-discovered). The
# collection's only required text fields should be name + slug.
WEBFLOW_IMAGE_COLLECTION_ID=
WEBFLOW_IMAGE_FIELD_SLUG=

# Pipedrive — API token for pipedrive-connector integration tests. Any account
# works (a free trial is enough); the suite creates and deletes its own
# `persons` records. Find it under Settings → Personal preferences → API in the
# Pipedrive web app.
PIPEDRIVE_API_KEY=
