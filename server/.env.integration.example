# See: https://dashboard.clerk.com/apps/app_2ymxByR3cEOiOZGKx91GRzHZQ3f/instances/ins_2ymxBtQskUovRqqMFxDlz8s4QNT/api-keys
CLERK_SECRET_KEY=<Get this from the Clerk Dashboard (Scratch Development App) or Chris>
INTEGRATION_TEST_USER_ID=user_EXAMPLE
INTEGRATION_TEST_CLIENT_DOMAIN=localhost:3000
INTEGRATION_TEST_API_DOMAIN=localhost:3010
# Optional
# Directs the test to use a specific workbook for the test
INTEGRATION_TEST_WORKBOOK_ID=
# Directs the test to use a specific table for the test, must be associated with the workbook above
INTEGRATION_TEST_TABLE_ID=

# Brevo API key for testing.
BREVO_API_KEY=

# Stripe — secret API key for connector integration tests (sk_test_... recommended)
STRIPE_CONNECTOR_API_KEY=

# Intercom — access token from a Developer Hub app (for intercom-connector integration tests)
INTERCOM_ACCESS_TOKEN=
# Optional — admin ID for creating articles. Auto-discovered from existing articles if not set.
INTERCOM_TEST_AUTHOR_ID=