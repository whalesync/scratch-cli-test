    {
      "id": "hmWO4A0xKPmBSZm0KxmRP",
      "type": "text",
      "x": 1312.3544013325732,
      "y": 686.1910538192792,
      "width": 470.4636535644531,
      "height": 388.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3qV",
      "roundness": null,
      "seed": 659558729,
      "version": 477,
      "versionNonce": 429981993,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1775076647231,
      "link": null,
      "locked": false,
      "text": "Enterprise plan since March 2022. Primary contact is Sarah Chen\n(VP Operations).\nRenewal due Q3 2025. Last year's renewal was delayed 6 weeks\ndue to procurement bottleneck.\nCurrently using Sales, Support, and Analytics modules. Has not\nadopted the new Forecasting module.\nExpressed interest in SSO integration during last QBR. IT team is\nthe blocker — awaiting internal security review.\nNPS score 8. Sarah is a strong advocate but flagged onboarding\nfriction for new team members.\nOpened 3 support tickets in the last 90 days, all resolved. No\nescalations.\nPotential upsell: 40+ seat expansion as they grow the APAC\nteam in Q2.\nCompetitor Salesforce was evaluated internally in Jan 2024 but\nAcme stayed. Price sensitivity is moderate.\nExecutive sponsor is CFO David Park. Prefers email\ncommunication, rarely joins calls.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "0LCwlJbgFmW0UD2L56Egc",
      "originalText": "Enterprise plan since March 2022. Primary contact is Sarah Chen (VP Operations).\nRenewal due Q3 2025. Last year's renewal was delayed 6 weeks due to procurement bottleneck.\nCurrently using Sales, Support, and Analytics modules. Has not adopted the new Forecasting module.\nExpressed interest in SSO integration during last QBR. IT team is the blocker — awaiting internal security review.\nNPS score 8. Sarah is a strong advocate but flagged onboarding friction for new team members.\nOpened 3 support tickets in the last 90 days, all resolved. No escalations.\nPotential upsell: 40+ seat expansion as they grow the APAC team in Q2.\nCompetitor Salesforce was evaluated internally in Jan 2024 but Acme stayed. Price sensitivity is moderate.\nExecutive sponsor is CFO David Park. Prefers email communication, rarely joins calls.",
      "autoResize": true,
      "lineHeight": 1.35
    },
