    {
      "id": "hmWO4A0xKPmBSZm0KxmRP",
      "type": "text",
      "x": 1312.3544013325732,
      "y": 686.1910538192792,
      "width": 470.4636535644531,
      "height": 388.8,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
