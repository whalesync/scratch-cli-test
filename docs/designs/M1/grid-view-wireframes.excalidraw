    {
      "id": "ZwWxUgFRMeDDyzl9EYAzH",
      "type": "text",
      "x": 506.0177462191448,
      "y": 2412.4247975248304,
      "width": 866.72802734375,
      "height": 32.5,
      "text": "The grid always shows only the current contents from disk: 1) what's being proposed else: 2) what has been approved; else: 3) current published state.\nI *think* it's too hard to review full diffs inline in the whole grid, but we'll probably have to build some ways to do that and understand it later.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "roundness": null,
      "seed": 1899174540,
      "groupIds": [],
      "boundElements": [],
      "isDeleted": false,
      "angle": 0,
      "version": 735,
      "versionNonce": 1889463422,
      "updated": 1775625681435,
      "link": null,
      "locked": false,
      "containerId": null,
