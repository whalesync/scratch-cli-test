<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spinner.docker-disk-check</string>
    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.local/bin/docker-disk-check.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/docker-disk-check.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/docker-disk-check.stderr.log</string>
</dict>
</plist>
