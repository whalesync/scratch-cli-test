{
  "description": "RFC6902 A.16 add an array value at '-' (append)",
  "base": {
    "foo": [
      "bar"
    ]
  },
  "patch": [
    {
      "op": "add",
      "path": "/foo/-",
      "value": [
        "abc",
        "def"
      ]
    }
  ],
  "expected": {
    "foo": [
      "bar",
      [
        "abc",
        "def"
      ]
    ]
  }
}
