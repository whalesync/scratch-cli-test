{
  "description": "RFC6902 A.6 move a value",
  "base": {
    "foo": {
      "bar": "baz",
      "waldo": "fred"
    },
    "qux": {
      "corge": "grault"
    }
  },
  "patch": [
    {
      "op": "move",
      "from": "/foo/waldo",
      "path": "/qux/thud"
    }
  ],
  "expected": {
    "foo": {
      "bar": "baz"
    },
    "qux": {
      "corge": "grault",
      "thud": "fred"
    }
  }
}
